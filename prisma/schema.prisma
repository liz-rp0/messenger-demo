datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  MANAGER
  MESSENGER
}

enum CaseStatus {
  PENDING
  ACCEPTED
  EN_ROUTE
  INSPECTING
  PAID
}

model User {
  id        String   @id @default(uuid())
  username  String   @unique
  password  String
  role      Role
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DeliveryCase {
  id           String     @id @default(uuid())
  orderNumber  String     @unique
  rawDetails   String
  itemDetails  String
  price        String
  phone        String
  mapUrl       String
  deliveryTime String?
  status       CaseStatus @default(PENDING)
  assignedTo   String?    // Messenger's name
  assignedToId String?    // Messenger's user id
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model InventoryItem {
  id              String   @id @default(uuid())
  sku             String   @unique
  product_name    String
  category        String
  stock_qty       Int
  min_order_point Int
  status          String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}
